<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg name)">
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur3e"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="safety_limits" default="true"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:arg name="ros_namespace" default=""/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.ros2_control.xacro"/>

  <link name="world"/>
  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    force_abs_paths="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
      <ros><namespace>$(arg ros_namespace)</namespace></ros>
    </plugin>
  </gazebo>

  <xacro:ur_ros2_control
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    initial_positions="${dict(shoulder_pan_joint=0.0,shoulder_lift_joint=-1.2,elbow_joint=-1.57,wrist_1_joint=-1.57,wrist_2_joint=1.57,wrist_3_joint=0.0)}"/>

  <link name="gripper_base_link">
    <visual>
      <origin xyz="0 0 -0.015"/>
      <geometry><box size="0.075 0.070 0.025"/></geometry>
      <material name="gripper_dark"><color rgba="0.18 0.20 0.22 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.015"/>
      <geometry><box size="0.075 0.070 0.025"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.015"/>
      <mass value="0.20"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="gripper_mount_joint" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="left_finger_link">
    <visual>
      <origin xyz="0 0 0.040"/>
      <geometry><box size="0.016 0.012 0.080"/></geometry>
      <material name="finger_gray"><color rgba="0.72 0.74 0.76 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.040"/>
      <geometry><box size="0.016 0.012 0.080"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.040"/>
      <mass value="0.035"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0 -0.050 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.040" effort="30" velocity="0.10"/>
    <dynamics damping="1.0" friction="0.2"/>
  </joint>

  <link name="right_finger_link">
    <visual>
      <origin xyz="0 0 0.040"/>
      <geometry><box size="0.016 0.012 0.080"/></geometry>
      <material name="finger_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.040"/>
      <geometry><box size="0.016 0.012 0.080"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.040"/>
      <mass value="0.035"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="right_finger_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0 0.022 0"/>
  </joint>

  <link name="gripper_tcp"/>
  <joint name="gripper_tcp_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="gripper_tcp"/>
    <origin xyz="0 -0.004 0.080" rpy="0 0 0"/>
  </joint>

  <gazebo reference="left_finger_link">
    <mu1>12.0</mu1><mu2>12.0</mu2><kp>1000000</kp><kd>10</kd>
  </gazebo>
  <gazebo reference="right_finger_link">
    <mu1>12.0</mu1><mu2>12.0</mu2><kp>1000000</kp><kd>10</kd>
  </gazebo>

  <ros2_control name="gripper_system" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="left_finger_joint">
      <command_interface name="position"><param name="min">0</param><param name="max">0.040</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>