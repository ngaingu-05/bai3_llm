<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="ur3_pick_place">
    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table -->
    <model name="work_table">
      <static>true</static>
      <pose>-0.30 0 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 0.90 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 0.90 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.30 0.34 0.37 1</ambient>
            <diffuse>0.30 0.34 0.37 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Red Cube -->
    <model name="red_cube">
      <pose>-0.30 0.05 0.27 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.04</mass>
          <inertia><ixx>0.00000107</ixx><iyy>0.00000107</iyy><izz>0.00000107</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.85 0.12 0.10 1</ambient><diffuse>0.85 0.12 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Yellow Cube -->
    <model name="yellow_cube">
      <pose>-0.30 0.20 0.27 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.04</mass>
          <inertia><ixx>0.00000107</ixx><iyy>0.00000107</iyy><izz>0.00000107</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.92 0.78 0.08 1</ambient><diffuse>0.92 0.78 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Blue Cube -->
    <model name="blue_cube">
      <pose>-0.25 -0.12 0.27 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.04</mass>
          <inertia><ixx>0.00000107</ixx><iyy>0.00000107</iyy><izz>0.00000107</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.08 0.28 0.88 1</ambient><diffuse>0.08 0.28 0.88 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Green Cube -->
    <model name="green_cube">
      <pose>-0.25 -0.30 0.27 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.04</mass>
          <inertia><ixx>0.00000107</ixx><iyy>0.00000107</iyy><izz>0.00000107</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.15 0.72 0.15 1</ambient><diffuse>0.15 0.72 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Purple Cube -->
    <model name="purple_cube">
      <pose>-0.30 0.35 0.27 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.04</mass>
          <inertia><ixx>0.00000107</ixx><iyy>0.00000107</iyy><izz>0.00000107</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.58 0.15 0.72 1</ambient><diffuse>0.58 0.15 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Overhead Camera -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>-0.28 0 0.75 0 1.5708 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 0.04 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
        <sensor name="camera_sensor" type="camera">
          <camera>
            <horizontal_fov>1.5708</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>2.0</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>overhead_cam</topic>
          <visualize>false</visualize>
        </sensor>
      </link>
    </model>

    <!-- Visual Zone Markers on Table (static, visual only, no collision) -->
    <model name="marker_zone_a">
      <static>true</static>
      <pose>-0.25 -0.30 0.2505 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <geometry><box><size>0.08 0.08 0.001</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 0.7</ambient>
            <diffuse>0.8 0.2 0.2 0.7</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="marker_zone_b">
      <static>true</static>
      <pose>-0.25 -0.12 0.2505 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <geometry><box><size>0.08 0.08 0.001</size></box></geometry>
          <material>
            <ambient>0.2 0.3 0.9 0.7</ambient>
            <diffuse>0.2 0.3 0.9 0.7</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="marker_zone_c">
      <static>true</static>
      <pose>-0.25 0.28 0.2505 0 0 0</pose>
      <link name="link">
        <visual name="pad">
          <geometry><box><size>0.08 0.08 0.001</size></box></geometry>
          <material>
            <ambient>0.9 0.8 0.1 0.7</ambient>
            <diffuse>0.9 0.8 0.1 0.7</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
